---
// 留言區的表單與列表。讀寫都打 /api/comments（見 worker/index.js）。
// 正文（政策文案）由呼叫端寫在 .mdx 裡，這個元件只負責表單與清單這塊互動。
import { getStrings } from '../i18n/index.js';

const { page, locale = 'zh' } = Astro.props;
const t = getStrings(locale).comments;
// Site key 是公開資訊（本來就會印在頁面的 data-sitekey 屬性裡），
// Cloudflare Workers Builds 的 Git 建置流程沒有提供建置期環境變數可用，
// 試過會發現 Astro 建置時讀不到後台設的變數，所以直接寫死在這裡，
// 不用環境變數繞一手。Secret key 不受影響，那個只在 worker/index.js 的
// 執行期讀 env.TURNSTILE_SECRET_KEY，不會出現在任何前端程式碼裡。
const turnstileSiteKey = '0x4AAAAAAEtXFgBnziV68VEm';
---
<div class="comments" data-page={page} data-locale={locale}>
  <p class="comments-status" role="status">{t.loading}</p>
  <ul class="comments-list" hidden></ul>

  <form class="comments-form">
    <label>
      <span>{t.nameLabel}</span>
      <input type="text" name="author" placeholder={t.namePlaceholder} maxlength="60" autocomplete="off" />
    </label>
    <label>
      <span>{t.bodyLabel}</span>
      <textarea name="body" required maxlength="2000" rows="4" placeholder={t.bodyPlaceholder}></textarea>
    </label>
    {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} />}
    <p class="comments-form-error" role="alert" hidden></p>
    <button type="submit">{t.submit}</button>
  </form>
</div>

{turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script define:vars={{ i18n: t }}>
  // 這個元件目前只會在 about 頁掛一次，不用 querySelectorAll 支援多份實例
  // ——真的要掛第二份，Turnstile 的 window.turnstile 也不是每個實例各自一份，
  // 屆時要處理的不只是這裡。
  const root = document.querySelector('.comments');
  if (root) {
    const page = root.dataset.page;
    const locale = root.dataset.locale;
    const status = root.querySelector('.comments-status');
    const list = root.querySelector('.comments-list');
    const form = root.querySelector('.comments-form');
    const formError = root.querySelector('.comments-form-error');
    const submitButton = form.querySelector('button[type="submit"]');

    function renderComment(comment) {
      const item = document.createElement('li');

      const meta = document.createElement('div');
      meta.className = 'comments-item-meta';
      // D1 的 datetime('now') 存的是「YYYY-MM-DD HH:MM:SS」，沒有 T 也沒有時區。
      // 沒有 T 的字串在部分瀏覽器會被當成本地時間解析，不是 UTC，換成 ISO 格式再交給 Date。
      const postedAt = new Date(comment.created_at.replace(' ', 'T') + 'Z');
      meta.textContent = `${comment.author || i18n.anonymous} · ${postedAt.toLocaleDateString('zh-TW')}`;

      const body = document.createElement('p');
      // 留言一律當純文字渲染，不解析 HTML，避免留言內容被當成標記執行。
      body.textContent = comment.body;

      item.append(meta, body);
      return item;
    }

    async function loadComments() {
      try {
        const res = await fetch(`/api/comments?page=${encodeURIComponent(page)}&locale=${encodeURIComponent(locale)}`);
        if (!res.ok) throw new Error('load failed');
        const data = await res.json();
        const comments = data.comments ?? [];

        if (comments.length === 0) {
          status.textContent = i18n.empty;
          status.hidden = false;
          list.hidden = true;
          return;
        }

        list.innerHTML = '';
        comments.forEach((comment) => list.append(renderComment(comment)));
        status.hidden = true;
        list.hidden = false;
      } catch {
        status.textContent = i18n.loadError;
        status.hidden = false;
        list.hidden = true;
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      formError.hidden = true;

      const data = new FormData(form);
      const body = String(data.get('body') ?? '').trim();
      const author = String(data.get('author') ?? '').trim();
      const turnstileToken = String(data.get('cf-turnstile-response') ?? '');

      if (!body) {
        formError.textContent = i18n.bodyRequiredError;
        formError.hidden = false;
        return;
      }
      if (!turnstileToken) {
        formError.textContent = i18n.verifyError;
        formError.hidden = false;
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = i18n.submitting;

      try {
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ page, locale, author, body, turnstileToken }),
        });
        if (!res.ok) {
          // 403 只會是 Turnstile 沒過關（見 worker/index.js），其餘一律當成通用送出失敗。
          // 用跟「還沒驗證」不同的文字，不然兩種狀態分不出來。
          formError.textContent = res.status === 403 ? i18n.verifyFailedError : i18n.submitError;
          // TODO 除錯用，問題排除後拿掉這段。
          if (res.status === 403) {
            const errBody = await res.json().catch(() => null);
            if (errBody?.errorCodes?.length) formError.textContent += ` (${errBody.errorCodes.join(', ')})`;
          }
          formError.hidden = false;
          // 驗證碼過期或已使用都會落到這裡，畫面卻停在舊的「成功」勾勾，
          // 不重置的話使用者再按一次送出還是帶同一個失效的驗證碼。
          if (res.status === 403 && window.turnstile) window.turnstile.reset();
          return;
        }

        form.reset();
        if (window.turnstile) window.turnstile.reset();
        await loadComments();
      } catch {
        formError.textContent = i18n.submitError;
        formError.hidden = false;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = i18n.submit;
      }
    });

    loadComments();
  }
</script>

<style>
  .comments { margin-top: 24px; }
  .comments-status { color: var(--text-dim); font-size: var(--fs-xs); }
  .comments-list { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .comments-list li {
    border: 1px solid var(--border); border-radius: 12px;
    padding: 14px 16px; background: var(--bg-card);
  }
  .comments-item-meta { font-size: var(--fs-3xs); color: var(--text-dim); margin-bottom: 6px; }
  .comments-list p { margin: 0; font-size: var(--fs-xs); line-height: 1.75; color: var(--text); white-space: pre-wrap; }

  .comments-form { display: flex; flex-direction: column; gap: 14px; max-width: 480px; }
  .comments-form label { display: flex; flex-direction: column; gap: 6px; font-size: var(--fs-2xs); color: var(--text-dim); }
  .comments-form input,
  .comments-form textarea {
    font-family: inherit; font-size: var(--fs-xs); color: var(--text);
    border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px;
    background: var(--bg-card); resize: vertical;
  }
  .comments-form input:focus,
  .comments-form textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }

  .comments-form-error { color: #b3423a; font-size: var(--fs-2xs); margin: 0; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .comments-form-error { color: #e08a83; }
  }
  :root[data-theme="dark"] .comments-form-error { color: #e08a83; }

  .comments-form button {
    align-self: flex-start; font-family: inherit; font-size: var(--fs-2xs); cursor: pointer;
    border: 1px solid var(--accent); background: var(--accent); color: var(--on-accent);
    padding: 10px 20px; border-radius: 20px;
  }
  .comments-form button:hover { opacity: 0.9; }
  .comments-form button:disabled { opacity: 0.6; cursor: not-allowed; }
</style>
