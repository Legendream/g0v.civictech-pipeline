---
// 全站圖示只在這裡定義一次，各頁用名字取用。
// 一律 28×28 線條、stroke 吃 currentColor，顏色由外面的容器決定。
// 純裝飾，所以掛 aria-hidden：旁邊的 H2 文字已經把意思講完了。
const { name, size = 28 } = Astro.props;

const P = {
  // 發現、查找
  search: '<circle cx="12.5" cy="12.5" r="6.5"/><line x1="17.5" y1="17.5" x2="22" y2="22"/>',
  // 消息傳遞
  megaphone: '<path d="M6 12v4l3 .5L10.5 22l2.5-.7-1.3-4.6L21 19V7l-9.5 3H8a2 2 0 0 0-2 2Z"/>',
  // 建議、靶心
  target: '<circle cx="14" cy="14" r="9"/><circle cx="14" cy="14" r="4.5"/><circle cx="14" cy="14" r="0.8" fill="currentColor" stroke="none"/>',
  // 清單、堆疊
  stack: '<rect x="6" y="6" width="16" height="4" rx="1"/><rect x="6" y="12" width="16" height="4" rx="1"/><rect x="6" y="18" width="16" height="4" rx="1"/>',
  // 書寫
  pen: '<path d="M6 22l1-4.5L17.5 7a2.1 2.1 0 0 1 3 3L10 20.5 5.5 22Z"/><line x1="15.5" y1="9" x2="19" y2="12.5"/>',
  // 量尺、邊界
  ruler: '<rect x="4" y="10" width="20" height="8" rx="1.5"/><line x1="9" y1="10" x2="9" y2="13.5"/><line x1="14" y1="10" x2="14" y2="13.5"/><line x1="19" y1="10" x2="19" y2="13.5"/>',
  // 兩欄比較
  compare: '<rect x="4.5" y="6" width="8" height="16" rx="1.5"/><rect x="15.5" y="6" width="8" height="16" rx="1.5"/>',
  // 階段、步驟
  steps: '<path d="M5 22h5v-5h5v-5h5V7"/><line x1="5" y1="22" x2="23" y2="22"/>',
  // 品質把關
  shield: '<path d="M14 5l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V8Z"/><path d="M10.5 14l2.5 2.5 5-5"/>',
  // 授權、天秤
  scale: '<line x1="14" y1="6" x2="14" y2="22"/><line x1="8" y1="22" x2="20" y2="22"/><line x1="6" y1="10" x2="22" y2="10"/><path d="M6 10l-2.5 5h5Z"/><path d="M22 10l-2.5 5h5Z"/>',
  // 發布、網路
  globe: '<circle cx="14" cy="14" r="9"/><ellipse cx="14" cy="14" rx="4" ry="9"/><line x1="5" y1="14" x2="23" y2="14"/>',
  // 文件、範例
  doc: '<path d="M8 4h8l5 5v15H8Z"/><path d="M16 4v5h5"/><line x1="11" y1="14" x2="18" y2="14"/><line x1="11" y1="18" x2="16" y2="18"/>',
  // 準備清單
  checklist: '<rect x="6" y="5" width="16" height="18" rx="1.5"/><path d="M9.5 13l2.5 2.5L18.5 9"/>',
  // 格線、矩陣
  grid: '<rect x="5" y="5" width="7.5" height="7.5" rx="1.5"/><rect x="15.5" y="5" width="7.5" height="7.5" rx="1.5"/><rect x="5" y="15.5" width="7.5" height="7.5" rx="1.5"/><rect x="15.5" y="15.5" width="7.5" height="7.5" rx="1.5"/>',
  // 分岔路徑
  route: '<circle cx="8" cy="7" r="2.5"/><circle cx="20" cy="21" r="2.5"/><path d="M8 9.5V15a3 3 0 0 0 3 3h6"/>',
  // 驗證
  verify: '<circle cx="14" cy="14" r="9"/><path d="M10 14l2.8 2.8L18.5 11"/>',
  // 問答
  chat: '<path d="M6 6h16v12h-9l-5 4v-4H6Z"/><line x1="10" y1="11" x2="18" y2="11"/><line x1="10" y1="14.5" x2="15" y2="14.5"/>',
  // 合作、兩個人
  people: '<circle cx="10" cy="10" r="3.2"/><circle cx="19" cy="11" r="2.6"/><path d="M4.5 22c0-3.3 2.5-5.5 5.5-5.5s5.5 2.2 5.5 5.5"/><path d="M17.5 16.6c2.6.2 4.5 2.2 4.5 5.4"/>',
  // 隱私
  lock: '<rect x="6.5" y="12" width="15" height="10" rx="2"/><path d="M10 12V9a4 4 0 0 1 8 0v3"/>',
  // 回饋
  mail: '<rect x="4.5" y="7" width="19" height="14" rx="2"/><path d="M4.5 9l9.5 6.5L23.5 9"/>',
  // 時效
  clock: '<circle cx="14" cy="14" r="9"/><path d="M14 8.5V14l4 2.5"/>',
  // 適用範圍
  book: '<path d="M5 6h6.5A2.5 2.5 0 0 1 14 8.5V22a3 3 0 0 0-3-2.5H5Z"/><path d="M23 6h-6.5A2.5 2.5 0 0 0 14 8.5V22a3 3 0 0 1 3-2.5h6Z"/>',
  // 時間軸左欄：AI
  bot: '<rect x="6" y="9.5" width="16" height="12" rx="3"/><line x1="14" y1="5" x2="14" y2="9.5"/><circle cx="14" cy="4" r="1.4"/><circle cx="10.5" cy="15" r="1.2" fill="currentColor" stroke="none"/><circle cx="17.5" cy="15" r="1.2" fill="currentColor" stroke="none"/>',
  // 時間軸右欄：人
  user: '<circle cx="14" cy="10" r="4"/><path d="M6 22c0-4.2 3.6-7 8-7s8 2.8 8 7"/>',
  // 摘要卡的打勾
  check: '<path d="M6 14.5l5 5L22 8.5"/>',
};

const path = P[name];
if (!path) throw new Error(`Icon: unknown name "${name}". Available: ${Object.keys(P).join(', ')}`);
---
<svg
  class="icon"
  viewBox="0 0 28 28"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={path}
/>

<style>
  .icon { flex-shrink: 0; display: block; }
</style>
