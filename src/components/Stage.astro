---
// 時間軸的一站。左欄 AI 執行（淡綠實底），右欄人決定（虛線框），
// 兩欄各配一個圖示，對得上上方圖例。
import Icon from './Icon.astro';
const { num, title, ai, human } = Astro.props;
---
<li class="stage">
  <div class="head">
    <span class="num">{num}</span>
    <span class="title">{title}</span>
  </div>
  <div class="cols">
    <div class="col ai"><Icon name="bot" size={16} /><span>{ai}</span></div>
    <div class="col human"><Icon name="user" size={16} /><span>{human}</span></div>
  </div>
</li>

<style>
  .stage {
    border: 1px solid var(--border); border-radius: 12px;
    padding: 16px 18px; background: var(--bg-card); margin: 0;
  }
  .head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  /* 編號用的是 ①-⑧，字形本身已經有一圈，再包一顆實心圓會變成圈中圈。
     所以只上色放大，不畫底。 */
  .num {
    flex-shrink: 0; color: var(--accent);
    font-weight: 700; font-size: var(--fs-lg); line-height: 1;
  }
  .title { font-weight: 700; font-size: var(--fs-sm); color: var(--text); line-height: 1.5; }

  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .col {
    display: flex; align-items: flex-start; gap: 8px;
    border-radius: 8px; padding: 10px 12px;
    font-size: var(--fs-2xs); line-height: 1.6; color: var(--text);
  }
  .col :global(.icon) { color: var(--accent); margin-top: 2px; }
  .ai { background: var(--accent-bg); border: 1px solid transparent; }
  .human { border: 1px dashed var(--border); }

  @media (max-width: 720px) { .cols { grid-template-columns: 1fr; } }
</style>
