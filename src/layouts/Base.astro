---
// 全站共用版型。
// 規矩：介面字串一律從 src/i18n/<語言>.json 取，不要寫死在這個檔裡。
// 配色沿用舊站 write.claire-cheng.com 的那一套，讀者看得出是同一件事的延續。
import { getLocaleFromPath, getStrings, htmlLang, localesWithPage } from '../i18n/index.js';

const { frontmatter } = Astro.props;
const title = frontmatter?.title ?? Astro.props.title ?? '';
const description = frontmatter?.description ?? Astro.props.description ?? '';

const locale = getLocaleFromPath(Astro.url.pathname);
const t = getStrings(locale);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const navItems = t.nav.map((item) => ({
  label: item.label,
  // 一律帶結尾斜線，跟 Astro 產出的網址（/zh/why/）一致：
  // 少了它 aria-current 比不到，而且每次點擊都會多吃一次轉址
  href: `/${locale}/${item.path}/`.replace(/\/+$/, '/'),
}));
const aboutHref = `/${locale}/about/`;
// hreflang 只宣告「那個語言底下真的有這一頁」的網址。
// 翻譯單位是頁，允許某頁只有中文，宣告不存在的網址會把讀者跟搜尋引擎帶去 404。
const alternates = localesWithPage(Astro.url.pathname);
---
<!doctype html>
<html lang={htmlLang(locale)}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | {t.siteName}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map(({ locale: l, path }) => (
  <link rel="alternate" hreflang={htmlLang(l)} href={new URL(path, Astro.site).href} />
))}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{/* 明暗模式在畫面畫出來之前就要定案，否則手動選了暗色的人會先看到一閃的亮色。
    沒有存過選擇就不加 data-theme，讓 prefers-color-scheme 自己決定。 */}
<script is:inline>
  try {
    var saved = localStorage.getItem('theme');
    if (saved === 'dark' || saved === 'light') {
      document.documentElement.setAttribute('data-theme', saved);
    }
  } catch (e) {}
</script>
<style is:global>
  /* 亮色是預設值。暗色有兩條路徑：跟隨系統，或讀者自己按鈕選的 data-theme。
     兩邊都要寫，少一邊就會有一種情況切不過去。 */
  :root {
    --bg: #fbfaf8;
    --bg-card: #ffffff;
    --text: #1f2320;
    --text-dim: #5a6058;
    --border: #e1ddd4;
    --accent: #2f6f4f;
    --accent-bg: #eaf3ec;
    /* 疊在 accent 實心底色上的前景色。亮色用白字，暗色的 accent 是淺綠，
       白字只有 2.2:1，要換成深色才讀得到（7.95:1）。 */
    --on-accent: #ffffff;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #191a17;
      --bg-card: #222420;
      --text: #eceae4;
      --text-dim: #a3a89e;
      --border: #383a34;
      --accent: #6fbf94;
      --accent-bg: #223028;
      --on-accent: #191a17;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #191a17;
    --bg-card: #222420;
    --text: #eceae4;
    --text-dim: #a3a89e;
    --border: #383a34;
    --accent: #6fbf94;
    --accent-bg: #223028;
    --on-accent: #191a17;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "PingFang TC", "Noto Sans TC",
                 "Microsoft JhengHei", system-ui, sans-serif;
    line-height: 1.75;
    font-size: 17px;
  }

  /* 頁首與頁尾比內文寬一點（760），內文是 680，讀起來才不會整頁一樣寬。 */
  .wrap { max-width: 760px; margin: 0 auto; padding: 0 24px; }

  .topbar { display: flex; justify-content: flex-end; align-items: center; gap: 10px; padding-top: 20px; }
  .locale-pill {
    border: 1px solid var(--border); color: var(--text-dim);
    padding: 6px 12px; border-radius: 20px; font-size: 12px;
  }
  .theme-toggle {
    border: 1px solid var(--border); background: var(--bg-card); color: var(--text);
    padding: 8px 14px; border-radius: 20px; font-size: 13px; cursor: pointer;
    font-family: inherit;
  }
  .theme-toggle:hover { border-color: var(--accent); color: var(--accent); }

  header { border-bottom: 1px solid var(--border); }
  header .wrap {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px 20px; padding-block: 16px;
  }
  .site-name { font-weight: 600; font-size: 15px; color: var(--text); text-decoration: none; }
  /* 導覽項目數量不寫死成四等分，之後語言不同項目數不同也不會破版 */
  nav { display: flex; gap: 16px; flex-wrap: wrap; }
  nav a { color: var(--text-dim); text-decoration: none; font-size: 14px; }
  nav a:hover, nav a[aria-current="page"] { color: var(--accent); }

  main { display: block; }
  /* 保險絲：萬一有內容沒包進色塊，照樣置中收窄。
     一定要排除 nav（sticky 捲動導覽是滿版的，收窄會讓底線只剩中間一段）
     與 script／style（它們不該吃到版面規則）。 */
  main > :not(section):not(nav):not(script):not(style) {
    max-width: 680px; margin-inline: auto; padding-inline: 24px;
  }
  main > :not(section):not(nav):not(script):not(style):first-child { margin-top: 40px; }
  main > :not(section):not(nav):not(script):not(style):last-child { margin-bottom: 80px; }

  h1 { font-size: 2.2rem; line-height: 1.3; margin: 0 0 24px; letter-spacing: -0.01em; }
  h2 { font-size: 1.4rem; line-height: 1.5; margin: 0 0 16px; }
  h3 { font-size: 1.08rem; line-height: 1.6; margin: 28px 0 10px; color: var(--text); }
  h4 { font-size: 1rem; margin: 20px 0 8px; color: var(--text); }
  p { margin: 0 0 16px; line-height: 1.8; }
  a { color: var(--accent); }
  strong { font-weight: 700; color: var(--text); }
  hr { border: 0; border-top: 1px solid var(--border); margin: 32px 0; }

  ul, ol { margin: 0 0 16px; padding-left: 22px; line-height: 1.8; }
  li { margin-bottom: 8px; }
  li:last-child { margin-bottom: 0; }
  li > ul, li > ol { margin-top: 8px; }

  blockquote {
    margin: 0 0 16px; padding: 12px 18px;
    border-left: 3px solid var(--accent);
    background: var(--bg-card);
    border-radius: 0 8px 8px 0;
    color: var(--text-dim);
  }
  blockquote > :last-child { margin-bottom: 0; }

  /* 表格：舊站從來沒定義過樣式，手機上會被裁切。
     外層捲動容器由 rehype 外掛自動包，Markdown 裡不必加任何 class。 */
  .table-scroll { overflow-x: auto; margin: 0 0 16px; -webkit-overflow-scrolling: touch; }
  table {
    width: 100%; min-width: 420px; border-collapse: collapse;
    font-size: 0.9rem; background: var(--bg-card);
    border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
  }
  /* 表頭用實心 accent，不用淺色底：淺色底疊在淺色色塊上會分不出來 */
  thead tr { background: var(--accent); }
  th {
    text-align: left; font-weight: 700; padding: 10px 14px;
    color: var(--on-accent);
    /* 分隔線用 accent-bg：亮色是淺色壓在深綠上、暗色是深色壓在淺綠上，兩邊都看得見 */
    border-right: 1px solid var(--accent-bg);
  }
  th:last-child { border-right: 0; }
  td {
    padding: 10px 14px; color: var(--text);
    border-top: 1px solid var(--border); border-right: 1px solid var(--border);
  }
  td:last-child { border-right: 0; }
  tbody tr:nth-child(even) td { background: var(--accent-bg); }

  /* 程式碼配色固定 GitHub Dark，不隨明暗模式變，比照舊站 astro-code 的做法 */
  pre {
    margin: 0 0 16px; padding: 14px 18px;
    background: #24292e !important; color: #e1e4e8;
    border-radius: 8px; overflow-x: auto;
    font-size: 14px; line-height: 1.7;
    -webkit-overflow-scrolling: touch;
  }
  pre code { background: none; padding: 0; color: inherit; font-size: inherit; }
  code {
    background: var(--accent-bg); color: var(--text);
    padding: 2px 6px; border-radius: 4px;
    font-size: 0.88em;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }

  img { max-width: 100%; height: auto; }

  footer { border-top: 1px solid var(--border); color: var(--text-dim); font-size: 13px; }
  footer .wrap { padding-block: 24px; }
  footer a { font-weight: 600; }
  .licence { margin: 8px 0 0; }

  .skip { position: absolute; left: -9999px; }
  .skip:focus { position: static; display: inline-block; padding: 8px 16px; }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 640px) {
    h1 { font-size: 1.75rem; }
    h2 { font-size: 1.25rem; }
  }
</style>
</head>
<body>
<a class="skip" href="#main">{t.skipToContent}</a>
<div class="wrap topbar">
  {/* 語言切換器佔位。英文版上線時這裡換成真正的 swapLocale() 清單。 */}
  <span class="locale-pill">{t.localeLabel}</span>
  <button
    type="button"
    class="theme-toggle"
    id="theme-toggle"
    data-to-dark={t.themeToDark}
    data-to-light={t.themeToLight}
  >{t.themeToDark}</button>
</div>
<header>
  <div class="wrap">
    <a class="site-name" href={`/${locale}/`}>{t.siteName}</a>
    <nav>
      {navItems.map((item) => (
        <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
<main id="main">
  <slot />
</main>
<footer>
  <div class="wrap">
    <a href={aboutHref}>{t.aboutLabel}</a>
    <p class="licence">
      {t.licence}
      <a href="https://creativecommons.org/licenses/by/4.0/deed.zh-hant" rel="license">{t.licenceLinkLabel}</a>
    </p>
  </div>
</footer>
<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var root = document.documentElement;
    var media = window.matchMedia('(prefers-color-scheme: dark)');

    function isDark() {
      var set = root.getAttribute('data-theme');
      return set ? set === 'dark' : media.matches;
    }
    // 按鈕字面寫的是「按下去會變成什麼」，所以現在是暗色就顯示「切換成亮色」
    function sync() {
      btn.textContent = isDark() ? btn.dataset.toLight : btn.dataset.toDark;
    }
    btn.addEventListener('click', function () {
      var next = isDark() ? 'light' : 'dark';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('theme', next); } catch (e) {}
      sync();
    });
    // 還沒手動選過的人，系統換模式時按鈕字也要跟著換
    media.addEventListener('change', function () {
      if (!root.getAttribute('data-theme')) sync();
    });
    sync();
  })();
</script>
</body>
</html>
