{
  // Cloudflare Workers 的部署設定。
  // 五頁正文仍然是 Astro 建置出來的純靜態 HTML；"main" 指到的 worker/index.js
  // 只處理 /api/comments 這一條路徑，其餘請求原封不動交給靜態資源（見 worker/index.js）。
  //
  // 這個名字必須跟 Cloudflare 上那個 Worker 的名字一模一樣，
  // 否則 wrangler deploy 會另外生一個新的 Worker 出來。
  // Worker 建立之後改不了名，所以這裡也不要動。
  "name": "g0v-civictech-pipeline",

  // 留言區的後端程式。沒有這個 worker/index.js 之前，assets 是唯一的處理者；
  // 加上它之後，靜態資源仍然優先比對（run_worker_first 預設 false），
  // 只有比對不到檔案的請求（例如 /api/comments）才會進到這支程式。
  "main": "./worker/index.js",

  // 決定這個 Worker 用哪一版的執行環境。往後調會拿到新行為，
  // 沒事不要動；要動請確認過那一版的變更說明。
  "compatibility_date": "2026-09-05",

  // 自訂網域。寫在這裡而不是在後台點，有兩個好處：
  // 部署時 wrangler 會自己建立網域與 DNS 記錄，不必依賴介面；
  // 而且「這個站掛在哪個網址」變成版控的一部分，看 repo 就知道。
  "routes": [
    { "pattern": "civictech-guide.claire-cheng.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",

    // 找不到的網址回傳 404.html（由 src/pages/404.md 產生），
    // 而不是丟一頁 Cloudflare 的預設錯誤畫面。
    "not_found_handling": "404-page",

    // worker/index.js 用 env.ASSETS.fetch(request) 把非 /api/ 的請求轉給靜態資源，
    // 這個 binding 名稱要跟程式碼裡的 env.ASSETS 對上。
    "binding": "ASSETS"
  },

  // 留言資料表的 D1 binding。database_id 是佔位值，
  // 跑過 `wrangler d1 create g0v-civictech-comments` 之後，
  // 把指令印出來的真正 id 貼進來取代下面這行。
  // 資料表結構在 db/schema.sql，要另外用
  // `wrangler d1 execute g0v-civictech-comments --remote --file=./db/schema.sql` 套用。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "g0v-civictech-comments",
      "database_id": "＿執行 wrangler d1 create 之後貼上真正的 database_id＿"
    }
  ]
}
